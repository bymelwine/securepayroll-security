# Exemple uniquement. Aucun chargement automatique des fichiers .env.
# Exporter ces variables dans l’environnement du processus PHP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secure_payroll
DB_USER=svc_php
# À renseigner exclusivement dans un environnement privé ; vide = invalide.
DB_PASSWORD=
# Activer uniquement après installation et vérification des nouveaux objets SQL.
SETTLEMENT_ENABLED=0
IAM_ENABLED=0
